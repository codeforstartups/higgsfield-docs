# REST examples
HF_API_KEY_ID=your-api-key-id
HF_API_KEY_SECRET=your-api-key-secret

# Official SDKs use a combined credential value.
HF_KEY=your-api-key-id:your-api-key-secret
HF_CREDENTIALS=your-api-key-id:your-api-key-secret

# Campaign workspace backend (FastAPI). Never put these in the Next.js app.
OPENAI_API_KEY=your-openai-api-key

# Campaign workspace frontend (optional; defaults to http://localhost:8010)
NEXT_PUBLIC_API_URL=http://localhost:8010
# Frontend: npm run dev in web/ (port 3001 if 3000 is already in use)
